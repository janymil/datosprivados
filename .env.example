# Host público del producto: se usa en la Política, los consentimientos y los
# enlaces que copias para tu bio de Instagram o WhatsApp.
# Si se deja vacío se usa el dominio comercial https://datosprivados.pe
# En local puedes poner http://localhost:3000 para que los enlaces abran aquí.
NEXT_PUBLIC_APP_URL=

# MercadoPago Suscripciones — cobro recurrente mensual o anual.
# Sin MERCADOPAGO_ACCESS_TOKEN, el entorno de desarrollo muestra un botón de
# activación manual; producción falla cerrada y no permite activar cuentas.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Secreto del webhook (Panel de MercadoPago > Webhooks). Si se define, se valida
# la firma x-signature. En producción conviene configurarlo.
MERCADOPAGO_WEBHOOK_SECRET=
# Usa 1 para forzar el checkout sandbox; con un token TEST- se activa solo.
MERCADOPAGO_SANDBOX=

# Ruta alternativa para la base SQLite (por defecto ./data/datosprivados.db)
# DATOSPRIVADOS_DB=./data/datosprivados.db

# La cookie de sesión es Secure por defecto en producción (HTTPS). Fuera de
# producción puedes poner COOKIE_SECURE=0; en producción el arranque lo rechaza.
# COOKIE_SECURE=1 fuerza Secure también fuera de producción.
# COOKIE_SECURE=1

# Verificación del RUC en el registro (Decolecta → SUNAT). Obligatorio en producción.
# Token en https://decolecta.com/profile · documentación: https://decolecta.gitbook.io/docs
DECOLECTA_API_TOKEN=

# IA (opcional). Sin ninguna clave, las funciones de IA usan el modo básico.
# Si hay ANTHROPIC_API_KEY se usa Claude; si no, OpenAI.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
OPENAI_API_KEY=
# OPENAI_MODEL=

# Solo desarrollo: 0 oculta el botón de activación manual de pago. Con
# PAYMENTS_DEV_BYPASS=1 en producción el servidor no arranca.
# PAYMENTS_DEV_BYPASS=

# Respaldos (scripts/backup-db.mjs): días que se conservan localmente.
# BACKUP_RETENTION_DAYS=7
