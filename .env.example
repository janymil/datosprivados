# URL pública usada en los documentos generados (política, consentimientos).
# En local puedes dejarla vacía: se usa https://privadope.pe como marcador.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Ruta alternativa para la base SQLite (por defecto ./data/privadope.db)
# PRIVADOPE_DB=./data/privadope.db

# Obliga a que la cookie de sesión solo viaje por HTTPS (actívalo en producción).
# COOKIE_SECURE=1
