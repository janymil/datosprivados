# Host público del producto: se usa en la Política, los consentimientos y los
# enlaces que copias para tu bio de Instagram o WhatsApp.
# Si se deja vacío se usa el dominio comercial https://datosprivados.pe
# En local puedes poner http://localhost:3000 para que los enlaces abran aquí.
NEXT_PUBLIC_APP_URL=

# MercadoPago Suscripciones — cobro recurrente mensual o anual.
# Sin MERCADOPAGO_ACCESS_TOKEN, el entorno de desarrollo muestra un botón de
# activación manual; producción falla cerrada y no permite activar cuentas.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Secreto del webhook (Panel de MercadoPago > Webhooks). Si se define, se valida
# la firma x-signature. En producción conviene configurarlo.
MERCADOPAGO_WEBHOOK_SECRET=
# Usa 1 para forzar el checkout sandbox; con un token TEST- se activa solo.
MERCADOPAGO_SANDBOX=
# Solo para pruebas E2E: servidores simulados en lugar de api.mercadopago.com y api.decolecta.com.
# DECOLECTA_API_BASE=
# MERCADOPAGO_API_BASE=

# Ruta alternativa para la base SQLite (por defecto ./data/datosprivados.db)
# DATOSPRIVADOS_DB=./data/datosprivados.db

# La cookie de sesión es Secure por defecto en producción (HTTPS). Fuera de
# producción puedes poner COOKIE_SECURE=0; en producción el arranque lo rechaza.
# COOKIE_SECURE=1 fuerza Secure también fuera de producción.
# COOKIE_SECURE=1

# Verificación del RUC en el registro (Decolecta → SUNAT). Obligatorio en producción.
# Token en https://decolecta.com/profile · documentación: https://decolecta.gitbook.io/docs
DECOLECTA_API_TOKEN=

# IA (opcional). Sin ninguna clave, las funciones de IA usan el modo básico.
# Si hay ANTHROPIC_API_KEY se usa Claude; si no, OpenAI.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
OPENAI_API_KEY=
# OPENAI_MODEL=
# Solo para pruebas E2E: servidores simulados de los modelos.
# ANTHROPIC_API_BASE=
# OPENAI_API_BASE=

# Solo desarrollo: 1 muestra el botón de activación manual de pago (sin cobro).
# Es opcional y está apagado por defecto. Con PAYMENTS_DEV_BYPASS=1 en producción
# el servidor no arranca.
# PAYMENTS_DEV_BYPASS=

# Respaldos (scripts/backup-db.mjs): días que se conservan localmente.
# BACKUP_RETENTION_DAYS=7
# Cifrado del respaldo en reposo (AES-256-GCM). Con esta variable el archivo pasa a
# `*.db.gz.enc` y restaurarlo exige la misma clave. Genérala con `openssl rand -base64 32`
# y guárdala FUERA del servidor (gestor de contraseñas): si se pierde, los respaldos
# cifrados no se pueden abrir. Ver docs/RUNBOOK.md.
# BACKUP_ENCRYPTION_KEY=

# --- Fase 3 -----------------------------------------------------------------

# Correo transaccional. Proveedor: Resend (API HTTP). MAIL_PROVIDER=log escribe los
# correos en la consola (solo desarrollo). Sin proveedor en producción los correos
# quedan en la bandeja de salida (email_outbox) y no se pierden.
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM="DatosPrivados <no-responder@datosprivados.pe>"
# Secreto (whsec_…) con el que Resend firma los webhooks de rebotes y quejas → POST /api/mail/webhook.
MAIL_WEBHOOK_SECRET=
# Solo pruebas E2E: servidor de correo simulado.
# MAIL_API_BASE=

# Tareas programadas: POST /api/cron/<tarea> con "Authorization: Bearer $CRON_SECRET".
# Mínimo 16 caracteres; sin él, la ruta rechaza todo. Ver docs/RUNBOOK.md.
CRON_SECRET=
# Días que se conserva una cuenta vencida antes de borrarla (mínimo 45; por defecto 90).
# LAPSED_RETENTION_DAYS=90

# Control de la IA: AI_DISABLED=1 la apaga; AI_MONTHLY_BUDGET_USD es el tope de gasto
# mensual estimado (se apaga sola al alcanzarlo); ALERT_EMAIL recibe el aviso y también
# el aviso diario de gasto. AI_DAILY_ALERT_USD fija el umbral del día (por defecto el
# 20 % del mensual); 0 lo desactiva.
# Los precios por millón de tokens sirven para estimar el gasto (por defecto 3 / 15).
# AI_DISABLED=
AI_MONTHLY_BUDGET_USD=
ALERT_EMAIL=
# AI_DAILY_ALERT_USD=10
# AI_PRICE_IN_USD_PER_MTOK=3
# AI_PRICE_OUT_USD_PER_MTOK=15
# Pruebas: pausa base de los reintentos al proveedor de IA, en ms (por defecto 500).
# LLM_RETRY_BASE_MS=

# Facturación y transferencias (Fase 4).
# Correos (separados por coma) que pueden entrar a /operador para emitir facturas y confirmar transferencias.
# OPERATOR_EMAILS=
# Datos bancarios que se muestran y envían a quien elige pagar por transferencia (texto libre: banco, titular, cuenta, CCI).
# Sin este valor, la transferencia no se ofrece.
# TRANSFER_BANK_DETAILS=

# Sandbox de MercadoPago (solo pruebas). Cuentas de prueba y app de sandbox: ver docs/MERCADOPAGO-SANDBOX.md
# Se usan con variables de entorno al levantar un servidor de prueba; NO reemplazan a MERCADOPAGO_ACCESS_TOKEN.
# MERCADOPAGO_SANDBOX_APP_ID=
# MERCADOPAGO_SANDBOX_ACCESS_TOKEN=
# MERCADOPAGO_SANDBOX_PUBLIC_KEY=
# Cuentas de prueba (login en el checkout de MercadoPago)
# MERCADOPAGO_TEST_SELLER_USER=
# MERCADOPAGO_TEST_SELLER_PASSWORD=
# MERCADOPAGO_TEST_SELLER_CODE=
# MERCADOPAGO_TEST_BUYER_USER=
# MERCADOPAGO_TEST_BUYER_PASSWORD=
# MERCADOPAGO_TEST_BUYER_CODE=

# --- Fase 6: operación -------------------------------------------------------
# Carpeta de respaldos que vigila la alerta de antigüedad (>26 h) en GET /api/cron/health.
# BACKUP_DIR=/var/backups/datosprivados
# Webhooks fallidos en 24 h a partir de los cuales se alerta (por defecto 3).
# ALERT_WEBHOOK_FAILURES=3
