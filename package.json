{
  "name": "datosprivados",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "description": "Cumplimiento de la Ley 29733 para MYPE peruanas",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "test:e2e": "CSP_ENFORCE=1 next build && playwright test",
    "audit:prod": "pnpm audit --prod",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "ops:weekly": "node scripts/weekly-report.mjs",
    "ops:restore-drill": "node scripts/restore-drill.mjs",
    "ops:loadtest": "node scripts/loadtest.mjs"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "playwright": "^1.64.1",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
